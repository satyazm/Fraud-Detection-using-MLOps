# Copy to `.env` and fill in real values for local development.
# Nothing reads this file yet — the CLI takes these as flags
# (`fraud-detection producer --topic ...`) with the same defaults shown
# here. Documented so later phases (serving, feature store) know what
# to expect.

# --- App ---
APP_ENV=dev
LOG_LEVEL=DEBUG

# --- Kafka (Milestone 4: Streaming — implemented) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=transactions

# --- Redis (feature/session cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MLflow (Milestone 3: experiment tracking & model registry — implemented) ---
MLFLOW_TRACKING_URI=file:./mlruns

# --- Feast (feature store, later milestone) ---
FEAST_REPO=./feature_repo

# --- Serving API (Milestone 6) ---
API_HOST=0.0.0.0
API_PORT=8000
