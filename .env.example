# Copy to `.env` and fill in real values for local development.
# Nothing reads this file yet in Phase 1 — it documents the environment
# variables later phases (streaming, serving, feature store, tracking)
# will expect.

# --- App ---
APP_ENV=dev
LOG_LEVEL=DEBUG

# --- Kafka (Phase 4: Streaming Ingestion) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=paysim-transactions

# --- Redis (feature/session cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MLflow (Phase 2: experiment tracking & model registry) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Feast (feature store, later phase) ---
FEAST_REPO=./feature_repo

# --- Serving API (Phase 5) ---
API_HOST=0.0.0.0
API_PORT=8000
